/* --- ESTILOS GLOBAIS --- */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #f4f7f6;
    color: #333;
    line-height: 1.6;
    padding: 20px;
}

/* --- CABEÇALHO --- */
header {
    text-align: center;
    background-color: #2e7d32;
    color: white;
    padding: 40px 20px;
    border-radius: 10px;
    margin-bottom: 30px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

header h1 {
    font-size: 2.2rem;
    margin-bottom: 10px;
}

header p {
    font-size: 1.1rem;
    opacity: 0.9;
}

/* --- CONTEÚDO PRINCIPAL --- */
main {
    max-width: 800px;
    margin: 0 auto;
}

/* --- SEÇÃO DO FORMULÁRIO --- */
.formulario {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    margin-bottom: 30px;
}

.formulario h2 {
    margin-bottom: 15px;
    color: #2e7d32;
}

input[type="text"], 
textarea {
    width: 100%;
    padding: 12px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.3s;
}

input[type="text"]:focus, 
textarea:focus {
    border-color: #2e7d32;
}

button.btn-publicar {
    background-color: #2e7d32;
    color: white;
    border: none;
    padding: 12px 25px;
    font-size: 1rem;
    font-weight: bold;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.3s;
    width: 100%;
}

button.btn-publicar:hover {
    background-color: #1b5e20;
}

/* --- CARTÕES DE PUBLICAÇÃO --- */
.post {
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
    margin-bottom: 20px;
    border-left: 5px solid #2e7d32;
}

.post h3 {
    color: #1b5e20;
    margin-bottom: 10px;
}

.post p {
    color: #555;
    white-space: pre-wrap;
}

.post-rodape {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 15px;
}

.post .data {
    font-size: 0.85rem;
    color: #888;
}

.btn-excluir {
    background-color: #d32f2f;
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: background 0.3s;
}

.btn-excluir:hover {
    background-color: #9a0007;
}